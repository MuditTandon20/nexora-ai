ENVIRONMENT=development
DATABASE_URL=sqlite:///./nexora.db
# Deployment: postgresql+psycopg://nexora:password@host:5432/nexora?sslmode=require
FRONTEND_ORIGIN=http://localhost:3000
SESSION_HOURS=12
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# Production uploads: private S3-compatible bucket, credentials server-side only.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional approved provider with a Chat Completions-compatible JSON API.
# Leave empty to disable AI. No paid inference is made by setup or demo seeding.
AI_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
AI_DAILY_LIMIT=20
